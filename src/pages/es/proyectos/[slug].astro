---
import CaseDetail from '../../../components/CaseDetail.astro';
import { getAllCases } from '../../../lib/cases';

export async function getStaticPaths() {
  const cases = await getAllCases('es');
  return cases.map((entry) => ({ params: { slug: entry.data.key }, props: { entry } }));
}
const { entry } = Astro.props;
---
<CaseDetail lang="es" entry={entry} />
