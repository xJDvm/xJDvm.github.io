---
import CaseDetail from '../../../components/CaseDetail.astro';
import { getAllCases } from '../../../lib/cases';
import { caseSlug } from '../../../i18n';

export async function getStaticPaths() {
  const cases = await getAllCases('en');
  return cases.map((entry) => ({ params: { slug: caseSlug('en', entry.data.key) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<CaseDetail lang="en" entry={entry} />
