---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ApiConsole from './ApiConsole';
import CaseArt from './CaseArt.astro';
import Metrics from './Metrics.astro';
import DecisionCard from './DecisionCard.astro';
import { decisions } from '../i18n/decisions';
import { dict, paths, EMAIL, GITHUB, LINKEDIN, type Lang, type ConsoleEndpoint } from '../i18n';
import { getCases, getSide, blockClass } from '../lib/cases';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = dict[lang];
const cases = await getCases(lang);
const sideRaw = await getSide(lang);
const side = await Promise.all(sideRaw.map(async (m) => ({ m, Content: (await render(m)).Content })));
const es = lang === 'es';

const endpoints: ConsoleEndpoint[] = [
  {
    id: 'cases', method: 'GET', path: es ? '/casos' : '/cases', status: 200, sql: 'SELECT', ui: 'list',
    body: { total: cases.length, items: cases.map((c) => ({ name: c.data.short, type: c.data.stack.slice(0, 2).join(' · '), status: c.data.tag })) },
  },
  {
    id: 'availability', method: 'GET', path: es ? '/disponibilidad' : '/availability', status: 200, sql: 'SELECT', ui: 'availability',
    body: es
      ? { disponible: true, empleo: 'full-stack', freelance: true, enfoque: ['IA', 'cloud'], experiencia_anios: 4, experiencia_ia_anios: 2.5, nexus_challenge: 'ganador', ubicacion: 'Valencia, VE', zona: 'GMT-4' }
      : { available: true, role: 'full-stack', freelance: true, focus: ['AI', 'cloud'], experience_years: 4, ai_experience_years: 2.5, nexus_challenge: 'winner', location: 'Valencia, VE', timezone: 'GMT-4' },
  },
  {
    id: 'contact', method: 'POST', path: es ? '/contacto' : '/contact', status: 201, sql: 'INSERT', ui: 'contact',
    body: es
      ? { ok: true, canal: 'email', para: EMAIL, siguiente_paso: 'Cuéntame el puesto o el proyecto.' }
      : { ok: true, channel: 'email', to: EMAIL, next_step: 'Tell me about the role or the project.' },
  },
];
const alternates = { es: paths.home('es'), en: paths.home('en') };
---
<Base lang={lang} alternates={alternates}>
  <section class="hero" id="top" aria-labelledby="h-hero">
    <div class="wrap">
      <div>
        <p class="status mono"><span class="dot" aria-hidden="true"></span>{t.status}</p>
        <h1 id="h-hero">{t.h1a} <span class="hl">{t.h1b}</span> <span class="hl p">{t.h1c}</span></h1>
        <p class="lede"><b>{t.ledeB}</b> {t.lede}</p>
        <p class="award mono"><span aria-hidden="true">★</span> {t.award}</p>
        <div class="cta">
          <a class="btn" href="#decisiones" data-cursor={t.cursorView}>{t.ctaWork} <span class="arr" aria-hidden="true">↓</span></a>
          <a class="btn hot" href={t.hireHref} data-cursor={t.cursorWrite}>{t.ctaHire}</a>
          <a class="btn alt" href={t.freelanceHref} data-cursor={t.cursorWrite}>{t.ctaFreelance}</a>
        </div>
        <p class="hero-meta mono">
          {t.meta.map((m) => <span>{m}</span>)}
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>
      </div>
      <ApiConsole client:load copy={t.console} endpoints={endpoints} email={EMAIL} />
    </div>
  </section>

  <div class="marq" aria-hidden="true"><div>
    {t.marquee.map((m) => <span>{m}</span>)}
    {t.marquee.map((m) => <span data-dup>{m}</span>)}
  </div></div>

  <section id="decisiones" class="decs" aria-labelledby="h-dec">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.dec.num}</p><h2 id="h-dec">{t.dec.h[0]}<br />{t.dec.h[1]}</h2></div>
      <p>{t.dec.p}</p>
    </div>
    <div class="wrap dec-grid">
      {decisions[lang].map((d) => <DecisionCard d={d} lang={lang} />)}
    </div>
  </section>

  <section id="trabajo" aria-labelledby="h-trabajo">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.workNum}</p><h2 id="h-trabajo">{t.workH[0]}<br />{t.workH[1]}</h2></div>
      <p>{t.workP}</p>
    </div>

    {cases.map((c, i) => {
      const d = c.data;
      const light = d.color === 'teal' || d.color === 'invert';
      return (
        <article class={`case ${blockClass(d.color)}${i % 2 ? ' flip' : ''}`} aria-labelledby={`case-${d.key}`}>
          <div class="wrap">
            <div class="reveal">
              <p class="idx">{d.label} · {d.period}</p>
              <h3 id={`case-${d.key}`}>{d.title}</h3>
              <p class="sum">{d.summary}</p>
              <dl class="facts">
                <div><dt>{t.facts.problem}</dt><dd>{d.problem}</dd></div>
                <div class="key"><dt>{t.facts.decision}</dt><dd>{d.decision}</dd></div>
                <div><dt>{t.facts.role}</dt><dd>{d.role}</dd></div>
                <div class="res"><dt>{t.facts.result}</dt><dd>{d.result}</dd></div>
              </dl>
              <Metrics items={d.metrics} label={t.facts.metrics} />
              <ul class="chips" aria-label={t.facts.stack}>{d.stack.map((s) => <li>{s}</li>)}</ul>
              <Metrics items={d.footprint} label={t.facts.footprint} note={t.facts.footprintNote} variant="footprint" />
              <a class={`btn more${light ? ' dark' : ''}`} href={paths.case(lang, d.key)} data-cursor={t.cursorRead}>
                {t.readCase}<span class="sr-only">: {d.title}</span> <span class="arr" aria-hidden="true">→</span>
              </a>
            </div>
            <div class="vis reveal">
              <div class="shot"><CaseArt k={d.key} lang={lang} /></div>
              <p class="metric"><b>{d.sticker.value}</b><span>{d.sticker.label}</span></p>
            </div>
          </div>
        </article>
      );
    })}
  </section>

  <section id="side" class="side" aria-labelledby="h-side">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.sideNum}</p><h2 id="h-side">{t.sideH[0]}<br />{t.sideH[1]}</h2></div>
      <p>{t.sideP}</p>
    </div>
    <div class="wrap side-grid">
      {side.map(({ m, Content }) => (
        <article class="mini reveal">
          <p class="mono kind">{m.data.kind} · {m.data.year}</p>
          <h3>{m.data.title}</h3>
          <div class="mini-body"><Content /></div>
          <p class="role"><span class="mono">{t.sideRole}</span> {m.data.role}</p>
          <ul class="chips" aria-label={t.facts.stack}>{m.data.stack.map((s) => <li>{s}</li>)}</ul>
          {m.data.link && <a class="mini-link" href={m.data.link} rel="noopener">{t.sideRepo} ↗<span class="sr-only">: {m.data.title}</span></a>}
        </article>
      ))}
    </div>
  </section>

  <section id="experiencia" class="exp" aria-labelledby="h-exp">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.expNum}</p><h2 id="h-exp">{t.expH[0]}<br />{t.expH[1]}</h2></div>
      <p>{t.expP}</p>
    </div>
    <div class="wrap exp-grid">
      {t.jobs.map((j) => (
        <article class="job reveal">
          <header class="job-head">
            <p class="mono">{j.when}</p>
            <h3>{j.title}</h3>
            <p class="org">{j.org}</p>
          </header>
          {j.award && (
            <div class="job-award">
              <p class="mono">{j.award.label}</p>
              <b>{j.award.what}</b>
              <span>{j.award.detail}</span>
            </div>
          )}
          <p class="job-intro">{j.intro}</p>
          <ul class="contrib">
            {j.items.map((it) => (
              <li><b>{it.what}</b><span>{it.detail}</span><small class="mono">{it.stack}</small></li>
            ))}
          </ul>
        </article>
      ))}
      <article class="job reveal">
        <header class="job-head"><p class="mono">2023 — 2025</p><h3>{t.academicH}</h3></header>
        <ul class="contrib">
          {t.academic.map((it) => (
            <li>
              <b>{it.what}</b><span>{it.detail}</span><small class="mono">{it.stack}</small>
              {it.key && <a href={paths.case(lang, it.key)}>{t.readThesis} →</a>}
              {it.link && <a href={it.link} rel="noopener">{t.sideRepo} ↗<span class="sr-only">: {it.what}</span></a>}
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="dark" id="proceso" aria-labelledby="h-proceso">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.processNum}</p><h2 id="h-proceso">{t.processH}</h2></div>
      <p>{t.processP}</p>
    </div>
    <div class="wrap proc">
      <div class="proc-stick" aria-hidden="true"><b id="proc-n">1</b><span class="mono" id="proc-l">{t.steps[0].l}</span></div>
      <ol class="steps">
        {t.steps.map((s) => (
          <li class="step" data-n={s.n} data-l={s.l} data-c={s.c} data-f={s.f}>
            <p class="mono">{s.k}</p><h3>{s.h}</h3><p>{s.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="stack" aria-labelledby="h-stack">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.stackNum}</p><h2 id="h-stack">{t.stackH[0]}<br />{t.stackH[1]}</h2></div>
      <p>{t.stackP}</p>
    </div>
    <div class="wrap stack">
      {t.tiles.map((tile) => (
        <div class="tile reveal">
          <h3>{tile.h}</h3>
          <ul>{tile.items.map(([name, where]) => <li>{name} <span>{where}</span></li>)}</ul>
        </div>
      ))}
    </div>
    <p class="wrap stack-note reveal">{t.stackNote}</p>
  </section>

  <section id="formacion" class="edu" aria-labelledby="h-edu">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.eduNum}</p><h2 id="h-edu">{t.eduH[0]}<br />{t.eduH[1]}</h2></div>
      <p>{t.eduP}</p>
    </div>
    <div class="wrap edu-grid">
      <ol class="edu-list reveal">
        {t.education.map((e) => (
          <li><span class="mono">{e.when}</span><h3>{e.what}</h3><p class="where">{e.where}</p><p>{e.detail}</p></li>
        ))}
      </ol>
      <div class="edu-side reveal">
        <div class="card-box">
          <h3>{t.langsH}</h3>
          <dl class="langs">{t.langs.map(([l, v]) => <div><dt>{l}</dt><dd>{v}</dd></div>)}</dl>
        </div>
        <div class="card-box">
          <h3>{t.skillsH}</h3>
          <ul class="chips">{t.skills.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="about invert" id="sobre" aria-labelledby="h-sobre">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.aboutNum}</p><h2 id="h-sobre">{t.aboutH[0]}<br />{t.aboutH[1]}</h2></div>
    </div>
    <div class="wrap about-grid">
      <div class="reveal">
        <p class="big">{t.aboutBig}</p>
        {t.aboutP.map((p) => <p>{p}</p>)}
        <div class="tools">
          <h3>{t.toolsH}</h3>
          <p>{t.toolsP}</p>
          <ul>{t.tools.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
      <dl class="tl reveal" aria-label={t.aboutFactsLabel}>
        {t.aboutFacts.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="contact" id="contacto" aria-labelledby="h-contacto">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.contactNum}</p><h2 id="h-contacto">{t.contactH}</h2></div>
      <p>{t.contactP}</p>
    </div>
    <div class="wrap reveal">
      <a class="mail" href={`mailto:${EMAIL}`} data-cursor={t.cursorWrite}>{EMAIL}</a>
      <div class="paths">
        {t.paths.map((p) => (
          <div class="path">
            <h3>{p.h}</h3>
            <p>{p.p}</p>
            <a class={`btn ${p.key === 'hire' ? 'hot' : ''}`} href={p.key === 'hire' ? t.hireHref : t.freelanceHref}>
              {p.cta} <span class="arr" aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
      <div class="contact-row">
        <button class="btn alt" type="button" data-copy={EMAIL} data-done={t.copied} hidden>{t.copy}</button>
        <a class="btn alt" href={GITHUB} rel="me noopener">{t.github} <span class="arr" aria-hidden="true">↗</span></a>
        <a class="btn alt" href={LINKEDIN} rel="me noopener">LinkedIn <span class="arr" aria-hidden="true">↗</span></a>
        {/* TODO(usuario): CV en PDF cuando esté actualizado. */}
      </div>
    </div>
  </section>
</Base>
