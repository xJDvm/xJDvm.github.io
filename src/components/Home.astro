---
/* Home como resumen: hero con pruebas, 3 casos compactos, más casos en una fila, hábitos en una línea,
   experiencia resumida, sobre mí y contacto. El detalle técnico vive en cada caso y en /decisiones/. */
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Gallery from './Gallery.astro';
import Scene3D from './Scene3D.astro';
import { galleries } from '../lib/shots';
import { dict, paths, EMAIL, GITHUB, LINKEDIN, type Lang } from '../i18n';
import { getAllCases, getCases, getSide } from '../lib/cases';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = dict[lang];
const cases = await getCases(lang);
const featured = cases.slice(0, 3);
const others = [...cases.slice(3), ...(await getAllCases(lang)).filter((c) => c.data.kind === 'academic')];
/* De los proyectos propios solo se muestran en la home los que tienen enlace verificable. */
const linked = (await getSide(lang)).filter((m) => m.data.link);
const proofHref = (to: string) => (to === 'experiencia' ? '#experiencia' : paths.case(lang, to));
const accent = ['var(--wine)', 'var(--red)', 'var(--teal)'];
const accentFg = ['#FFFFFF', '#FFFFFF', '#0B0B0F'];
const alternates = { es: paths.home('es'), en: paths.home('en') };
---
<Base lang={lang} alternates={alternates}>
  <section class="hero" id="top" aria-labelledby="h-hero">
    <div class="wrap">
      <div class="hero-copy">
        <p class="status mono"><span class="dot" aria-hidden="true"></span>{t.status}</p>
        <h1 id="h-hero">
          <span class="h1-name">{t.heroName}</span>
          {t.h1a} <span class="hl">{t.h1b}</span> {t.h1and} <span class="hl p">{t.h1c}</span>
        </h1>
        <p class="lede">{t.lede}</p>
        <div class="cta">
          <a class="btn hot" href={t.hireHref}>{t.ctaHire}</a>
          <a class="btn alt" href={t.freelanceHref}>{t.ctaFreelance}</a>
          <a class="btn ghost" href="#trabajo">{t.ctaWork} <span class="arr" aria-hidden="true">↓</span></a>
        </div>
        <ul class="proofs" aria-label={t.proofsLabel}>
          {t.proofs.map((p) => (
            <li>
              {p.to ? (
                <a class="proof" href={proofHref(p.to)}>
                  <span class="proof-k">{p.k}</span>
                  <b>{p.v}</b>
                  <span class="proof-d">{p.d}</span>
                </a>
              ) : (
                <div class="proof">
                  <span class="proof-k">{p.k}</span>
                  <b>{p.v}</b>
                  <span class="proof-d">{p.d}</span>
                </div>
              )}
            </li>
          ))}
        </ul>
        <p class="hero-meta">
          {t.meta.map((m) => <span>{m}</span>)}
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>
      </div>
      <Scene3D lang={lang} />
    </div>
  </section>

  <section id="trabajo" class="work" aria-labelledby="h-trabajo">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.workNum}</p><h2 id="h-trabajo">{t.workH[0]}<br />{t.workH[1]}</h2></div>
      <p>{t.workP}</p>
    </div>
    <ol class="wrap feat">
      {featured.map((c, i) => {
        const d = c.data;
        const h = d.home ?? { summary: d.summary, problem: d.problem, result: d.result, decision: d.decision, sticker: d.sticker };
        return (
          <li class="feat-card reveal" style={`--ac:${accent[i]};--af:${accentFg[i]}`}>
            <article aria-labelledby={`case-${d.key}`}>
              <p class="feat-idx">{d.label} · {d.period}</p>
              <h3 id={`case-${d.key}`}>{d.title}</h3>
              <dl class="feat-dl">
                <div><dt>{t.facts.problem}</dt><dd>{h.problem}</dd></div>
                <div class="feat-key"><dt>{t.dec.labels.decision}</dt><dd>{h.decision ?? d.decision}</dd></div>
              </dl>
              <p class="feat-stat"><b>{h.sticker.value}</b><span>{h.sticker.label}</span></p>
              <a class="btn feat-more" href={paths.case(lang, d.key)}>
                {t.readCase}<span class="sr-only">: {d.title}</span> <span class="arr" aria-hidden="true">→</span>
              </a>
            </article>
          </li>
        );
      })}
    </ol>
    <div class="wrap more reveal">
      <h3 class="more-h">{t.moreH}</h3>
      <ul class="more-list">
        {others.map((c) => (
          <li>
            <a class="more-card" href={paths.case(lang, c.data.key)}>
              <span class="more-k">{c.data.label} · {c.data.period}</span>
              <b>{c.data.title}</b>
              <span class="more-go">{t.readCase} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
        {linked.map((m) => {
          const key = m.id.split('/').pop()!;
          const gal = m.data.gallery ? galleries[m.data.gallery] : undefined;
          return (
            <li class={gal ? 'more-wide' : ''}>
              <div class="more-card">
                <span class="more-k">{m.data.kind} · {m.data.year}</span>
                <b>{m.data.title}</b>
                <span class="more-sum">{m.data.summary}</span>
                <a class="more-go" href={m.data.link} rel="noopener">{t.sideRepo} ↗<span class="sr-only">: {m.data.title}</span></a>
                {gal && (
                  <details class="more-shots">
                    <summary>{t.moreShots} ({gal.length})</summary>
                    <Gallery shots={gal} lang={lang} group={`side-${key}`} sizes="(max-width: 900px) 92vw, 640px" />
                  </details>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section id="decisiones" class="decs" aria-labelledby="h-dec">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.decideNum}</p><h2 id="h-dec">{t.decideH[0]}<br />{t.decideH[1]}</h2></div>
      <p>{t.decideP}</p>
    </div>
    <ol class="wrap habits">
      {t.steps.map((s) => (
        <li class="habit reveal" style={`--c:${s.c};--f:${s.f}`}>
          <span class="habit-n" aria-hidden="true">{s.n}</span>
          <div><h3>{s.h}</h3><p>{s.p}</p></div>
        </li>
      ))}
    </ol>
    <p class="wrap think-more reveal"><a class="btn" href={paths.decisions(lang)}>{t.think.more} <span class="arr" aria-hidden="true">→</span></a></p>
  </section>

  <section id="experiencia" class="exp" aria-labelledby="h-exp">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.expNum}</p><h2 id="h-exp">{t.expH.join(' ')}</h2></div>
      <p>{t.expP}</p>
    </div>
    <div class="wrap exp-grid">
      <ol class="timeline">
        {t.jobs.map((j) => (
          <li class="job reveal">
            <header class="job-head">
              <p class="job-when">{j.when}</p>
              <h3>{j.title}</h3>
              <p class="org">{j.org}</p>
            </header>
            {j.award && (
              <div class="job-award">
                <p class="mono">{j.award.label}</p>
                <b>{j.award.what}</b>
                <span>{j.award.detail}</span>
              </div>
            )}
            <p class="job-intro">{j.intro}</p>
            {j.items.length > 0 && (
              <details class="job-more">
                <summary>{t.contribH}</summary>
                <ul class="contrib">
                  {j.items.map((it) => (
                    <li><b>{it.what}</b><span>{it.detail}</span><small class="mono">{it.stack}</small></li>
                  ))}
                </ul>
              </details>
            )}
          </li>
        ))}
      </ol>
      <div class="exp-side">
        <div class="card-box reveal">
          <h3>{t.eduH}</h3>
          <ul class="edu-mini">
            {t.education.map((e) => (
              <li>
                <span class="edu-when">{e.when}</span>
                <b>{e.what}</b>
                <span>{e.where}{e.status && <> · <strong class="edu-status">{e.status}</strong></>}</span>
              </li>
            ))}
          </ul>
          <dl class="langs">{t.langs.map(([l, v]) => <div><dt>{l}</dt><dd>{v}</dd></div>)}</dl>
          <details class="job-more">
            <summary>{t.academicH} ({t.academic.length})</summary>
            <ul class="contrib">
              {t.academic.map((it) => (
                <li>
                  <b>{it.what}</b><span>{it.detail}</span><small class="mono">{it.stack}</small>
                  {it.key && <a href={paths.case(lang, it.key)}>{t.readThesis} →</a>}
                  {it.link && <a href={it.link} rel="noopener">{t.sideRepo} ↗<span class="sr-only">: {it.what}</span></a>}
                </li>
              ))}
            </ul>
          </details>
        </div>
        <div class="card-box stack-box reveal">
          <h3>{t.stackH}</h3>
          <p class="stack-note">{t.stackNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="about invert" id="sobre" aria-labelledby="h-sobre">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.aboutNum}</p><h2 id="h-sobre">{t.aboutH[0]}<br />{t.aboutH[1]}</h2></div>
    </div>
    <div class="wrap about-grid">
      <div class="reveal">
        <p class="big">{t.aboutBig}</p>
        {t.aboutP.map((p) => <p>{p}</p>)}
      </div>
      <div class="tools reveal">
        <h3><Icon name="Network" size={20} /> {t.toolsH}</h3>
        <p>{t.toolsP}</p>
      </div>
    </div>
  </section>

  <section class="contact" id="contacto" aria-labelledby="h-contacto">
    <div class="wrap sec-head reveal">
      <div><p class="num mono">{t.contactNum}</p><h2 id="h-contacto">{t.contactH}</h2></div>
      <p><strong class="reply">{t.contactReply}</strong> {t.contactP}</p>
    </div>
    <div class="wrap reveal">
      <a class="mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <div class="paths">
        {t.paths.map((p) => (
          <div class="path">
            <h3>{p.h}</h3>
            <p>{p.p}</p>
            <a class={`btn ${p.key === 'hire' ? 'hot' : ''}`} href={p.key === 'hire' ? t.hireHref : t.freelanceHref}>
              {p.cta} <span class="arr" aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
      <div class="contact-row">
        <button class="btn alt" type="button" data-copy={EMAIL} data-done={t.copied} hidden>{t.copy}</button>
        <a class="btn alt" href={GITHUB} rel="me noopener">{t.github} <span class="arr" aria-hidden="true">↗</span></a>
        <a class="btn alt" href={LINKEDIN} rel="me noopener">LinkedIn <span class="arr" aria-hidden="true">↗</span></a>
        {/* TODO(usuario): CV en PDF cuando esté actualizado. */}
      </div>
    </div>
  </section>
</Base>
